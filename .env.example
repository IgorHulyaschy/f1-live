# Settings for `docker compose up`. Copy to `.env` to change any of them; every line is optional.

# Host ports. The stack listens on 127.0.0.1 only.
# WEB_PORT=8080
# RELAY_PORT=3300

# Where the saved sessions are: its out/ folder is served under /data. The default is the small
# fixture in the repository (three sessions). Point it at a full data folder to see everything.
# DATA_DIR=./client/e2e/real/data

# Where the ingest profile records and imports (raw/ and out/). Use the same folder as DATA_DIR to
# see new sessions in the app.
# INGEST_DATA_DIR=./data

# The ingest and the relay share this secret (16+ characters).
# RELAY_SECRET=pitwall-local-relay-secret
# POSTGRES_PASSWORD=pitwall-local-only

# An F1 TV subscription token for the ingest profile; without it the feed withholds car data.
# F1TV_TOKEN=

# How fast the replay profile plays the saved race.
# REPLAY_SPEED=100

# Production rules on this machine (a real secret, SMTP and Stripe become required):
# NODE_ENV=production
# BETTER_AUTH_SECRET=
# SMTP_URL=
# PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
