# The relay's public address and the shared secret (the same RELAY_SECRET the relay has).
RELAY_URL=https://api.example.com
RELAY_SECRET=

# An F1 TV subscription token; without it the feed withholds car data and positions.
F1TV_TOKEN=

# Where recordings and imported sessions are kept on this machine (an absolute path). Back this folder up: raw/ cannot
# be fetched again for a session that was only ever live.
DATA_DIR=/srv/pitwall-data
