{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2023", "dom", "dom.iterable"],
		"types": ["vite/client", "node"],
		"jsx": "react-jsx",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"src",
		"e2e",
		"shots",
		"scripts",
		"vite.config.ts",
		"playwright.config.ts",
		"playwright.build.config.ts"
	],
	"exclude": ["src/platform/service-worker.ts"]
}
