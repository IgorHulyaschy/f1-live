# Where race data comes from: "mock" (simulated replay, default) or "api" (the server).
VITE_DATA_SOURCE=mock

# Server endpoints, used when VITE_DATA_SOURCE=api. One server serves both on one port; a hosted
# setup can put the saved sessions on a CDN and the live socket on the relay.
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/live
