# Where race data comes from: "mock" (simulated replay, default) or "api" (the server).
VITE_DATA_SOURCE=mock

# Server endpoints, used when VITE_DATA_SOURCE=api. One server serves both on one port; a hosted
# setup can put the saved sessions on a CDN and the live socket on the relay.
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/live

# Accounts: the app calls /api on its own origin, and Vite sends it to this server. Start the
# server with ACCOUNTS_DB=pglite to sign in locally; without accounts, sign-in says it is off.
# ACCOUNTS_SERVER_URL=http://127.0.0.1:3000
# Only when the accounts API is on another (same-site) origin instead:
# VITE_ACCOUNTS_URL=

# A production build bakes these in, so one build serves one environment. docker-compose.yml builds
# with VITE_API_URL=/data (saved sessions under the app's own origin, served by Caddy); a hosted
# setup points VITE_API_URL at the bucket's domain and VITE_WS_URL and VITE_ACCOUNTS_URL at the
# relay. docs/deploy.md has both.

# Team radio audio is Formula 1 media, like the pictures: clips are announced either way, and
# "link" lets viewers open each one from the official archive. Off until there is a licence.
# VITE_TEAM_RADIO=link
