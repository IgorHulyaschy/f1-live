{
	"name": "@f1-live/client",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "npm run typecheck && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
		"test:unit": "node --test 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
		"test:e2e": "playwright test --project=e2e && playwright test -c playwright.build.config.ts --project=pwa && playwright test -c playwright.real.config.ts --project=real --project=live",
		"test:stack": "playwright test -c playwright.stack.config.ts",
		"brand-assets": "node scripts/brand-assets.ts",
		"budgets": "node scripts/budgets.ts",
		"italic-instances": "node scripts/italic-instances.ts",
		"shots": "playwright test --project=shots && playwright test -c playwright.build.config.ts --project=shots-build && playwright test -c playwright.real.config.ts --project=shots-real"
	},
	"dependencies": {
		"@f1-live/shared": "0.1.0",
		"@fontsource-variable/hubot-sans": "5.3.0",
		"@fontsource-variable/martian-mono": "5.3.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"lucide-react": "1.50.0",
		"motion": "14.0.0",
		"radix-ui": "1.6.7",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-grid-layout": "2.2.4",
		"react-router": "8.4.0",
		"recharts": "3.10.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"vite": "8.3.2"
	}
}
