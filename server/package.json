{
	"name": "@f1-live/server",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env ./src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"record": "tsx --env-file-if-exists=.env ./src/cli/record.ts",
		"typecheck": "tsc --noEmit",
		"test:unit": "node --import tsx --test 'src/**/*.test.ts'",
		"fetch:f1": "tsx ./src/cli/fetch-f1.ts",
		"replay-live": "tsx --env-file-if-exists=.env ./src/cli/replay-live.ts",
		"load-smoke": "tsx ./src/cli/load-smoke.ts"
	},
	"dependencies": {
		"@f1-live/shared": "0.1.0",
		"@fastify/cors": "11.3.0",
		"@fastify/websocket": "11.3.1",
		"fastify": "5.12.5",
		"ws": "8.22.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/ws": "8.18.2",
		"tsx": "4.23.15"
	}
}
