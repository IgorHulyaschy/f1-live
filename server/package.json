{
	"name": "@f1-live/server",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch --env-file=.env ./src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"migrations:generate": "npm run build && drizzle-kit generate",
		"migrations:up": "drizzle-kit migrate"
	},
	"dependencies": {
		"@fastify/cors": "11.3.0",
		"drizzle-orm": "0.45.3",
		"fastify": "5.12.5",
		"pg": "8.23.1",
		"ulid": "3.0.2",
		"ws": "8.22.0"
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"@types/ws": "8.18.2",
		"drizzle-kit": "0.31.11",
		"tsx": "4.23.15"
	}
}
