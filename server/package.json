{
	"name": "@f1-live/server",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env ./src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"record": "tsx --env-file-if-exists=.env ./src/cli/record.ts",
		"import": "tsx --env-file-if-exists=.env ./src/cli/import.ts",
		"rebuild": "tsx --env-file-if-exists=.env ./src/cli/rebuild.ts",
		"telemetry": "tsx --env-file-if-exists=.env ./src/cli/telemetry.ts",
		"prefetch": "tsx --env-file-if-exists=.env ./src/cli/prefetch.ts",
		"typecheck": "tsc --noEmit",
		"test:unit": "node --import tsx --test 'src/**/*.test.ts'",
		"fetch:f1": "tsx ./src/cli/fetch-f1.ts",
		"replay-live": "tsx --env-file-if-exists=.env ./src/cli/replay-live.ts",
		"load-smoke": "tsx ./src/cli/load-smoke.ts",
		"vapid": "tsx ./src/cli/vapid.ts",
		"accounts:generate": "drizzle-kit generate --config drizzle.accounts.config.ts",
		"index-gaps": "tsx ./src/cli/index-gaps.ts"
	},
	"dependencies": {
		"@electric-sql/pglite": "0.5.8",
		"@f1-live/shared": "0.1.0",
		"@fastify/cors": "11.3.0",
		"@fastify/websocket": "11.3.1",
		"better-auth": "1.7.7",
		"drizzle-orm": "0.45.3",
		"fastify": "5.12.5",
		"nodemailer": "10.0.13",
		"pg": "8.23.1",
		"stripe": "23.0.0",
		"web-push": "3.6.7",
		"ws": "8.22.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"@types/web-push": "3.6.4",
		"@types/ws": "8.18.2",
		"drizzle-kit": "0.31.11",
		"tsx": "4.23.15"
	}
}
