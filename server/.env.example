# Everything here is optional for local development: `npm run dev -w server` serves the live
# socket and the saved sessions on one port.

# all: ingest and relay in one process (local dev). ingest: reads the live feed and pushes events
# to RELAY_URL. relay: accepts pushed events and serves viewers.
MODE=all
HOST=127.0.0.1
PORT=3000

# Raw recordings go to $DATA_DIR/raw, imported sessions are served from $DATA_DIR/out.
# Defaults to the data/ folder at the repository root.
# DATA_DIR=

# Browser origins allowed to call the server and open /live, comma separated. Never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ingest and relay share this secret (16+ characters). RELAY_URL is the relay's base URL.
# RELAY_URL=https://relay.example.com
# RELAY_SECRET=

# An F1 TV subscription token. Without it the live feed withholds car data, positions,
# championship tables and pit stop times.
F1TV_TOKEN=

# Run the import when a session finishes, after this many seconds.
IMPORT_ON_FINISH=true
IMPORT_DELAY_SECONDS=60

# Accounts: sign-in, synced dashboards and Pro. Off unless a database is chosen.
# ACCOUNTS_DB=pglite keeps them in PGlite under $DATA_DIR/accounts and needs nothing else: sign-in
# links are printed to the log and payments use the fake provider. "memory" forgets on restart.
# DATABASE_URL (Postgres) is used whenever it is set; production requires it.
# ACCOUNTS_DB=pglite
# DATABASE_URL=postgres://user:password@localhost:5432/pitwall

# Where people open the app; sign-in and checkout send them back here. Browsers reach the accounts
# API under /api on this origin (Vite proxies it in development), or on ACCOUNTS_PUBLIC_URL.
# APP_URL=http://localhost:5173
# ACCOUNTS_PUBLIC_URL=

# The app and the API on sibling hosts (app.example.com and api.example.com): the session cookie
# is shared with every subdomain of this domain. Leave it out when /api is on the app's own origin.
# COOKIE_DOMAIN=example.com

# The product name in emails and payment pages; the owner's to choose.
# BRAND_NAME=Pitwall

# Signs session cookies. Required in production, 32+ characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Serve /api/dev/mailbox to requests that do not come from loopback. Only for docker compose, whose
# ports are published on 127.0.0.1; it is never on in production, where sign-in emails are real.
# DEV_MAILBOX_ANY_IP=true

# Sign-in email. Without SMTP_URL the link is printed to the log (development only).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Pitwall <sign-in@example.com>

# Google and Apple sign-in are on only when both values of a provider are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=

# fake (development default: a local checkout page) or stripe (production default).
# PAYMENTS_PROVIDER=fake
# FAKE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price ids for Pro; the prices themselves are set in Stripe by the owner.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# The fan library's moderation policy (the owner's to set; these are the defaults). Comma-separated
# lists extend the built-in reserved handles and blocked words.
# LIBRARY_RESERVED_HANDLES=
# LIBRARY_BLOCKED_WORDS=
# Different viewers reporting a dashboard before it is hidden pending review.
# LIBRARY_REPORTS_TO_HIDE=3
# Dashboards one account may keep published.
# LIBRARY_MAX_PUBLISHED=25

# Web Push for alerts (pit stop, flag, penalty, retirement, session start on a phone or desktop).
# `npm run vapid -w server -- --write` makes the pair and adds it here. Without keys, development
# makes its own and keeps it beside the database; production leaves push off until they are set.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Who the push services can reach about this server: a mailto: address or an https URL. The owner's.
# VAPID_SUBJECT=mailto:alerts@example.com
# A push subscription is a URL this server posts to, so only the browsers' own services are accepted
# (Google, Mozilla, Microsoft, Apple). Add another vendor's host here; `*.` allows its subdomains.
# PUSH_ENDPOINT_HOSTS=
